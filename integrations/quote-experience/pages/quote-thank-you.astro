---
// The MI-BOX quote experience — injected by the quote-experience integration
// (default route /quote-thank-you). WebGL configurator + live gofuse pricing;
// all per-site values (API host/token, brand name, phones, logo, service
// notes) come from the integration's options via virtual:quoting and
// virtual:quoting/config.
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import { getConfig, getQuote, previewQuote } from "virtual:quoting";
import type { QuoteConfig, QuotePreview } from "../runtime";
import {
  brandFrom,
  labelsFrom,
  lengthsAcross,
  monthlyFor,
  parseDimensions,
  productAtLength,
  totalFor,
  toServiceView,
  type ServiceView,
} from "../pricing";
import { sanitize, sanitizeToText } from "../sanitize";
import siteConfig from "virtual:quoting/config";
import qxScriptUrl from "../assets/quote-experience-vt.js?url";
import "../assets/quote-experience.css";
import "../assets/quote-experience-mibox.css";

// Every price, fee, label and service on this page comes from gofuse. Nothing
// here substitutes a default when the API is silent: a service with no catalog
// is disabled and a missing price renders as "Call for pricing", because a
// plausible-looking wrong number on a quote is worse than an absent one.

const q = Astro.url.searchParams;
const quoteId = q.get("q") ?? "";

let storedQuote: any = null;
if (quoteId) {
  try {
    storedQuote = await getQuote(quoteId);
  } catch (error) {
    console.error("quote-thank-you: getQuote failed —", (error as Error)?.message);
  }
}

// A stored quote reports service_type/product_type as { slug, name }; the
// redirect URL carries the same values as bare slugs.
const slugOf = (v: unknown): string | undefined =>
  typeof v === "string" ? v : (v as { slug?: string } | undefined)?.slug;

const params = {
  service_type: slugOf(storedQuote?.service_type) ?? q.get("service_type") ?? "",
  zip_code: storedQuote?.initial_zip ?? q.get("zip_code") ?? "",
  destination_zip_code: storedQuote?.final_zip ?? q.get("destination_zip_code") ?? "",
  full_name: storedQuote?.full_name ?? q.get("full_name") ?? "",
  product_type: slugOf(storedQuote?.product_type) ?? q.get("product_type") ?? "portable-storage",
  container_size: q.get("container_size") ?? "",
};

// One unfiltered config call returns the site's service types plus every active
// product tagged with the services it belongs to, which is exactly what the
// per-service calls return filtered. Fees still need a preview per service.
let baseConfig: QuoteConfig | null = null;
try {
  baseConfig = await getConfig({ zip_code: params.zip_code });
} catch (error) {
  console.error("quote-thank-you: getConfig failed —", (error as Error)?.message);
}

const apiServices = baseConfig?.service_types ?? [];
const previews = await Promise.all(
  apiServices.map(async ({ slug }) => {
    try {
      // product_type is required: omitting it makes gofuse return an empty
      // products/fees set with a 200 rather than defaulting to a product.
      return await previewQuote({
        service_type: slug,
        product_type: params.product_type,
        zip_code: params.zip_code,
        // gofuse needs the destination to price Move It's relocation leg. Sent
        // to every service and ignored where it does not apply.
        destination_zip_code: params.destination_zip_code || undefined,
      });
    } catch (error) {
      console.error(`quote-thank-you: previewQuote(${slug}) failed —`, (error as Error)?.message);
      return null as QuotePreview | null;
    }
  }),
);

const services: ServiceView[] = apiServices.map((st, i) =>
  toServiceView(
    st.slug,
    st.name,
    // Scope the shared catalog to this service the same way the API does.
    baseConfig
      ? { ...baseConfig, products: baseConfig.products.filter((p) => p.service_types?.includes(st.slug)) }
      : null,
    previews[i],
  ),
);

for (const s of services) {
  if (!s.totalsAgree) {
    console.error(
      `quote-thank-you: our total for ${s.slug} no longer matches gofuse's own ` +
        `(gofuse says ${s.apiTotal}). Pricing rules have changed — check extractFees().`,
    );
  }
}

const labels = labelsFrom(baseConfig?.settings);
const brand = brandFrom(baseConfig?.settings);
const lengths = lengthsAcross(services);

// Which service to open on. The customer's own choice wins, then whatever
// gofuse can actually price.
const selectedService =
  services.find((s) => s.slug === params.service_type && s.available) ??
  services.find((s) => s.slug === params.service_type) ??
  services.find((s) => s.available) ??
  services[0] ??
  null;

// Container length, in order of trust: the line items on the stored quote, the
// size the customer picked on the form, then whatever this service offers.
function lengthFromStoredQuote(): number | null {
  for (const item of storedQuote?.line_items ?? []) {
    // Line items carry a name ("16’ x 8’") but no dimensions, so match the name
    // against the catalog rather than parsing it.
    const match = services
      .flatMap((s) => s.products)
      .find((p) => p.name === item.name && p.lengthFt != null);
    if (match?.lengthFt != null) return match.lengthFt;
    const parsed = parseDimensions(item.name);
    if (parsed.lengthFt != null && lengths.includes(parsed.lengthFt)) return parsed.lengthFt;
  }
  return null;
}
function lengthFromParam(): number | null {
  const n = Number(/(\d+)/.exec(params.container_size)?.[1]);
  return Number.isFinite(n) && n > 0 ? n : null;
}
const availableLengths = selectedService?.products.map((p) => p.lengthFt).filter((n): n is number => n != null) ?? [];
const requestedLength = lengthFromStoredQuote() ?? lengthFromParam();
// A requested size gofuse does not stock for this service (the form still
// offers 8', which has no product) falls to the nearest size it does stock.
const selectedLength =
  requestedLength != null && availableLengths.includes(requestedLength)
    ? requestedLength
    : requestedLength != null && availableLengths.length
      ? (availableLengths.filter((n) => n <= requestedLength).pop() ?? Math.min(...availableLengths))
      : (availableLengths[0] ?? lengths[0] ?? null);

const selectedProduct =
  selectedService && selectedLength != null ? productAtLength(selectedService, selectedLength) : null;

// Presentational one-liners under each service name, configured per site.
// Absent for any service slug this site has not written copy for — never
// invented from the slug.
const SERVICE_NOTES: Record<string, string> = siteConfig.serviceNotes ?? {};

const outOfAreaText = services.map((s) => s.outOfAreaText).find(Boolean) ?? null;

const money = (cents: number) =>
  (cents / 100).toLocaleString("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  });

const sizeLabel = (lengthFt: number) => {
  const p = selectedService ? productAtLength(selectedService, lengthFt) : null;
  const cuft = p?.cuft ?? null;
  return {
    name: p?.name ?? `${lengthFt}'`,
    detail: [p?.dimensions, cuft ? `${cuft.toLocaleString()} ft³` : null].filter(Boolean).join(" · "),
  };
};

const reviews = (baseConfig?.reviews ?? []).filter((r) => r.name);
const faqs = (baseConfig?.faqs ?? []).filter((f) => f.question);
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();

const firstName = params.full_name.trim().split(/\s+/)[0] || "";
const brandName = siteConfig.brandName || "MI-BOX";
const title = firstName ? `${firstName}, here's your ${brandName} quote` : `Your ${brandName} Quote`;

// The client re-renders from this on every size/service change. It carries the
// API's numbers in cents, exactly as gofuse returned them.
const payload = {
  services: services.map((s) => ({ ...s, note: SERVICE_NOTES[s.slug] ?? null })),
  lengths,
  labels,
  brand,
  initial: { service: selectedService?.slug ?? null, lengthFt: selectedLength },
  logo: siteConfig.logo,
};
const payloadJson = JSON.stringify(payload).replace(/</g, "\\u003c");

// gofuse resolves the phone from the ZIP's service location, so it is the
// accurate number. The configured one is a last resort: when the API is down
// the page still has to offer a way to call.
const fallbackPhone = siteConfig.phones[0]?.number ?? null;
const phone = labels.phone ?? fallbackPhone;
const phoneDigits = (phone ?? "").replace(/\D/g, "");
const bookNowLink = labels.bookNowLink ?? (phoneDigits ? `tel:${phoneDigits}` : null);
const bookNowText = labels.bookNowText ?? (phone ? `Call ${phone}` : null);
---

<Layout title={title} description={`Configure your ${brandName} portable storage — size it, price it, done.`} noIndex={true}>
  <div class="qx qx-mibox">

    <section class="band" id="configure" style="background:#fbfbfa">
      <div class="wrap">
        <div class="cfg">
          <div class="sec-head reveal" style="align-self:center">
            <span class="eyebrow">{firstName ? `Thanks, ${firstName} — build it out` : "Build your quote"}</span>
            <h2>Size it. Price it. In real time.</h2>
            <p>Every number below is live {brandName} pricing. Change a choice and the monthly rate — and the container itself — updates instantly.</p>
          </div>

          <div class="viz reveal">
            <canvas id="gl-box" aria-hidden="true"></canvas>
            <div class="callouts">
              <span class="dimtag d-l" id="tag-h">8'</span>
              <span class="dimtag d-b" id="tag-l">{selectedLength ? `${selectedLength}'` : ""}</span>
              <span class="dimtag d-c mono" id="tag-v">{selectedProduct?.cuft ? `${selectedProduct.cuft.toLocaleString()} ft³` : ""}</span>
            </div>
          </div>

          <form class="panel reveal" id="cfg" aria-label="Quote configurator">
            <div class="panel-h">
              <span class="t">Configuration</span>
              <span class="tag" id="sku">{[selectedProduct?.name, selectedService?.name].filter(Boolean).join(" · ")}</span>
            </div>

            {lengths.length > 0 && (
              <div class="field">
                <label>Container size</label>
                <div class="seg" role="radiogroup" aria-label="Container size">
                  {lengths.map((ft) => {
                    const l = sizeLabel(ft);
                    const offered = availableLengths.includes(ft);
                    return (
                      <label class={`opt${offered ? "" : " unavailable"}`}>
                        <input type="radio" name="size" value={ft} checked={ft === selectedLength} disabled={!offered} />
                        <span class="box"><span class="k">{l.name}</span><span class="s">{l.detail}</span></span>
                      </label>
                    );
                  })}
                </div>
              </div>
            )}

            {services.length > 0 && (
              <div class="field">
                <label>Service</label>
                <div class={`seg${services.length >= 4 ? " four" : ""}`} role="radiogroup" aria-label="Service">
                  {services.map((s) => (
                    <label class={`opt${s.available ? "" : " unavailable"}`}>
                      <input type="radio" name="svc" value={s.slug} checked={s.slug === selectedService?.slug} disabled={!s.available} />
                      <span class="box"><span class="k">{s.name}</span><span class="s">{payload.services.find((p) => p.slug === s.slug)?.note ?? ""}</span></span>
                    </label>
                  ))}
                </div>
              </div>
            )}
          </form>

          <div class="panel reveal">
            <div class="qh">
              <span class="lab" id="products-label">{labels.products}</span>
              <span class="svc" id="svc-label">{selectedService?.name ?? ""}</span>
            </div>
            <div class="lines" id="lines"></div>
            <div class="transit-sec" id="transit-sec">
              <div class="transit-head"><span id="fees-label">{labels.fees}</span> <span>billed separately</span></div>
              <div id="transit-lines"></div>
              <div class="fees-total-row" id="fees-total-row" style="display:none"><span>Total Fees</span><span id="fees-total"></span></div>
            </div>
            <div class="total">
              <div>
                <div class="tl" id="due-label">{labels.total}</div>
                <div><span class="big" id="due-total">{
                  selectedProduct && selectedService ? money(totalFor(selectedService, selectedProduct)) : "—"
                }</span></div>
                <div class="then-mo" id="then-mo">{
                  selectedProduct && selectedService
                    ? `then ${money(monthlyFor(selectedService, selectedProduct))}/mo`
                    : ""
                }</div>
              </div>
              <div class="mono dim" style="text-align:right;font-size:.72rem" id="capacity">{selectedProduct?.idealFor[0] ?? ""}</div>
            </div>
            <div class="qcta">
              {bookNowLink && bookNowText && (
                <a class="btn primary" href={bookNowLink}>{bookNowText}</a>
              )}
              <a class="qq" href="#faq">Questions? Read the FAQ</a>
            </div>
            {labels.qualifying && <p class="dim panel-note" id="qualifying">{labels.qualifying}</p>}
            {labels.whatHappensNext && (
              <div class="dim panel-note" set:html={sanitize(labels.whatHappensNext)} />
            )}
            {outOfAreaText && <p class="dim panel-note">{outOfAreaText}</p>}
          </div>
        </div>
      </div>
    </section>

    {reviews.length > 0 && (
      <section class="band" id="reviews" style="background:#fbfbfa">
        <div class="wrap">
          <div class="sec-head reveal">
            <span class="eyebrow">From the driveway</span>
            <h2>Neighbors who stopped renting trucks.</h2>
          </div>
          <div class="revs">
            {reviews.map((r) => (
              <div class="rev reveal">
                <div class="stars">★★★★★</div>
                <div set:html={sanitize(r.content)} />
                <div class="by">
                  {r.avatar_url ? <img class="av" src={r.avatar_url} alt={r.name} style="object-fit:cover" /> : <span class="av">{initials(r.name)}</span>}
                  <span class="who"><b>{r.name}</b><span>{sanitizeToText(r.title)}</span></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="band" id="how">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">How it works</span>
          <h2>Three moves. That's the whole thing.</h2>
          <p>No truck to rent, no dolly, no weekend lost to a U-Haul. The container comes to you and waits on your schedule.</p>
        </div>
        <div class="steps">
          <div class="step reveal">
            <span class="idx">01 / Deliver</span>
            <svg class="diagram" viewBox="0 0 120 64" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 44h44V22H8zM52 30h20l10 8v6H52z" stroke-linejoin="round"/><circle cx="26" cy="50" r="4"/><circle cx="70" cy="50" r="4"/><path d="M96 44h16M104 36v16" class="a"/></svg>
            <h3>We set it level, right where you want it.</h3>
            <p>Our ground-level delivery lowers the box gently to the ground — flat floor, no tilt, no ramp to climb.</p>
          </div>
          <div class="step reveal">
            <span class="idx">02 / Pack</span>
            <svg class="diagram" viewBox="0 0 120 64" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="18" y="16" width="34" height="32" rx="2"/><rect x="60" y="26" width="20" height="22" rx="2"/><rect x="86" y="10" width="16" height="38" rx="2"/><path d="M12 52h100" class="a"/></svg>
            <h3>Load it over days, not one frantic afternoon.</h3>
            <p>It stays on your property as long as you need. Pack a room a night; lock it when you're done.</p>
          </div>
          <div class="step reveal">
            <span class="idx">03 / Keep · Move · Store</span>
            <svg class="diagram" viewBox="0 0 120 64" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 40h28V22H14z"/><path d="M52 31h10l6 5v4H52z"/><path d="M74 40l14-14M80 26h8v8" class="a"/><path d="M96 40h16V26H96z"/></svg>
            <h3>Leave it, relocate it, or we warehouse it.</h3>
            <p>Same box, three endings. Nothing gets re-handled — what you packed is what arrives.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="spec">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">The container</span>
          <h2>Engineered to protect what you pack.</h2>
          <p>Weatherproof steel and smart design — your belongings stay clean, dry, and secure.</p>
        </div>
        <div class="spec">
          <div class="cell reveal"><span class="v">14-ga</span><span class="k">Steel skin</span><p>Smooth galvanized steel panels — dent-resistant and rust-treated.</p></div>
          <div class="cell reveal"><span class="v">Ground</span><span class="k">Level loading</span><p>Ground-level delivery means a flat floor. No ramp, no lift, no strain.</p></div>
          <div class="cell reveal"><span class="v">Sealed</span><span class="k">Weather-tight</span><p>Gasketed roll-up door and vents keep rain, dust, and moisture out.</p></div>
          <div class="cell reveal"><span class="v">1 key</span><span class="k">Yours only</span><p>You hold the only key from delivery to the day it's emptied.</p></div>
        </div>
      </div>
    </section>

    {faqs.length > 0 && (
      <section class="band" id="faq">
        <div class="wrap">
          <div class="sec-head reveal">
            <span class="eyebrow">Before you book</span>
            <h2>The questions everyone asks.</h2>
          </div>
          <div class="faq reveal">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.question}</summary>
                <div class="ans" set:html={sanitize(f.answer)} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="end">
      <div class="wrap">
        <span class="eyebrow reveal">Ready when you are</span>
        <h2 class="reveal">Get the box on the calendar.</h2>
        <p class="reveal">Tell us your ZIP and a size — the local team calls back within one business hour with a firm, all-in number.</p>
        {bookNowLink && bookNowText && (
          <div class="phones reveal">
            <a class="btn dark" href={bookNowLink} style="min-width:220px">{bookNowText}</a>
          </div>
        )}
      </div>
    </section>

  </div>

  <script is:inline set:html={`window.__QX_DATA=${payloadJson}`}></script>
  <script is:inline type="module" src={qxScriptUrl}></script>
</Layout>
